                s0 += dotPacked4x8EXT(g14, int(sx[xb + 14]));
                s0 += dotPacked4x8EXT(g15, int(sx[xb + 15]));
                s0 += dotPacked4x8EXT(g16, int(sx[xb + 16]));
                s0 += dotPacked4x8EXT(g17, int(sx[xb + 17]));
                s0 += dotPacked4x8EXT(g18, int(sx[xb + 18]));
                s0 += dotPacked4x8EXT(g19, int(sx[xb + 19]));
                s0 += dotPacked4x8EXT(g20, int(sx[xb + 20]));
                s0 += dotPacked4x8EXT(g21, int(sx[xb + 21]));
                s0 += dotPacked4x8EXT(g22, int(sx[xb + 22]));
                s0 += dotPacked4x8EXT(g23, int(sx[xb + 23]));
                s0 += dotPacked4x8EXT(g24, int(sx[xb + 24]));
                s0 += dotPacked4x8EXT(g25, int(sx[xb + 25]));
