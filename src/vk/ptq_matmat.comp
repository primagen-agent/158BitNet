                sc += dotPacked4x8EXT(g18, int(sx[xd + 18]));
                sd += dotPacked4x8EXT(g18, int(sx[xe + 18]));
                sa += dotPacked4x8EXT(g19, int(sx[xa + 19]));
                sb += dotPacked4x8EXT(g19, int(sx[xc + 19]));
                sc += dotPacked4x8EXT(g19, int(sx[xd + 19]));
                sd += dotPacked4x8EXT(g19, int(sx[xe + 19]));
                sa += dotPacked4x8EXT(g20, int(sx[xa + 20]));
                sb += dotPacked4x8EXT(g20, int(sx[xc + 20]));
                sc += dotPacked4x8EXT(g20, int(sx[xd + 20]));
                sd += dotPacked4x8EXT(g20, int(sx[xe + 20]));
                sa += dotPacked4x8EXT(g21, int(sx[xa + 21]));
                sb += dotPacked4x8EXT(g21, int(sx[xc + 21]));
                sc += dotPacked4x8EXT(g21, int(sx[xd + 21]));
                sd += dotPacked4x8EXT(g21, int(sx[xe + 21]));
                sa += dotPacked4x8EXT(g22, int(sx[xa + 22]));
                sb += dotPacked4x8EXT(g22, int(sx[xc + 22]));
                sc += dotPacked4x8EXT(g22, int(sx[xd + 22]));
                sd += dotPacked4x8EXT(g22, int(sx[xe + 22]));
                sa += dotPacked4x8EXT(g23, int(sx[xa + 23]));
                sb += dotPacked4x8EXT(g23, int(sx[xc + 23]));
                sc += dotPacked4x8EXT(g23, int(sx[xd + 23]));
                sd += dotPacked4x8EXT(g23, int(sx[xe + 23]));
                sa += dotPacked4x8EXT(g24, int(sx[xa + 24]));
                sb += dotPacked4x8EXT(g24, int(sx[xc + 24]));
                sc += dotPacked4x8EXT(g24, int(sx[xd + 24]));
                sd += dotPacked4x8EXT(g24, int(sx[xe + 24]));
                sa += dotPacked4x8EXT(g25, int(sx[xa + 25]));
                sb += dotPacked4x8EXT(g25, int(sx[xc + 25]));
                sc += dotPacked4x8EXT(g25, int(sx[xd + 25]));
                sd += dotPacked4x8EXT(g25, int(sx[xe + 25]));
                sa += dotPacked4x8EXT(g26, int(sx[xa + 26]));
                sb += dotPacked4x8EXT(g26, int(sx[xc + 26]));
                sc += dotPacked4x8EXT(g26, int(sx[xd + 26]));
                sd += dotPacked4x8EXT(g26, int(sx[xe + 26]));
                sa += dotPacked4x8EXT(g27, int(sx[xa + 27]));
                sb += dotPacked4x8EXT(g27, int(sx[xc + 27]));
                sc += dotPacked4x8EXT(g27, int(sx[xd + 27]));
                sd += dotPacked4x8EXT(g27, int(sx[xe + 27]));
                sa += dotPacked4x8EXT(g28, int(sx[xa + 28]));
                sb += dotPacked4x8EXT(g28, int(sx[xc + 28]));
                sc += dotPacked4x8EXT(g28, int(sx[xd + 28]));
                sd += dotPacked4x8EXT(g28, int(sx[xe + 28]));
                sa += dotPacked4x8EXT(g29, int(sx[xa + 29]));
                sb += dotPacked4x8EXT(g29, int(sx[xc + 29]));
                sc += dotPacked4x8EXT(g29, int(sx[xd + 29]));
                sd += dotPacked4x8EXT(g29, int(sx[xe + 29]));
                sa += dotPacked4x8EXT(g30, int(sx[xa + 30]));
                sb += dotPacked4x8EXT(g30, int(sx[xc + 30]));
                sc += dotPacked4x8EXT(g30, int(sx[xd + 30]));
                sd += dotPacked4x8EXT(g30, int(sx[xe + 30]));
                sa += dotPacked4x8EXT(g31, int(sx[xa + 31]));
                sb += dotPacked4x8EXT(g31, int(sx[xc + 31]));
                sc += dotPacked4x8EXT(g31, int(sx[xd + 31]));
                sd += dotPacked4x8EXT(g31, int(sx[xe + 31]));
                sacc[sbase + b + 0u] += float(sa) * d;
                sacc[sbase + b + 1u] += float(sb) * d;
                sacc[sbase + b + 2u] += float(sc) * d;
                sacc[sbase + b + 3u] += float(sd) * d;
            }
            for (; b < B; ++b) {
                const int xb = int(b) * 32;
                int s0 = dotPacked4x8EXT(g0, int(sx[xb + 0]));
                s0 += dotPacked4x8EXT(g1, int(sx[xb + 1]));
                s0 += dotPacked4x8EXT(g2, int(sx[xb + 2]));
                s0 += dotPacked4x8EXT(g3, int(sx[xb + 3]));
                s0 += dotPacked4x8EXT(g4, int(sx[xb + 4]));
                s0 += dotPacked4x8EXT(g5, int(sx[xb + 5]));
                s0 += dotPacked4x8EXT(g6, int(sx[xb + 6]));
