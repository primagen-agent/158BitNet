                s0 += dotPacked4x8EXT(g29, int(sx[xb + 29]));
                s0 += dotPacked4x8EXT(g30, int(sx[xb + 30]));
                s0 += dotPacked4x8EXT(g31, int(sx[xb + 31]));
                sacc[sbase + b] += float(s0) * d;
            }
        }
        barrier();
    }
    if (live) {
        for (uint b = 0u; b < B; ++b)
            y[b * pc.n_rows + row] = sacc[sbase + b] * pc.xscale[b];
    }
}
