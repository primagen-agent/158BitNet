                sa += dotPacked4x8EXT(g10, int(sx[xa + 10]));
                sb += dotPacked4x8EXT(g10, int(sx[xc + 10]));
                sc += dotPacked4x8EXT(g10, int(sx[xd + 10]));
                sd += dotPacked4x8EXT(g10, int(sx[xe + 10]));
                sa += dotPacked4x8EXT(g11, int(sx[xa + 11]));
                sb += dotPacked4x8EXT(g11, int(sx[xc + 11]));
                sc += dotPacked4x8EXT(g11, int(sx[xd + 11]));
                sd += dotPacked4x8EXT(g11, int(sx[xe + 11]));
                sa += dotPacked4x8EXT(g12, int(sx[xa + 12]));
                sb += dotPacked4x8EXT(g12, int(sx[xc + 12]));
                sc += dotPacked4x8EXT(g12, int(sx[xd + 12]));
                sd += dotPacked4x8EXT(g12, int(sx[xe + 12]));
                sa += dotPacked4x8EXT(g13, int(sx[xa + 13]));
                sb += dotPacked4x8EXT(g13, int(sx[xc + 13]));
                sc += dotPacked4x8EXT(g13, int(sx[xd + 13]));
                sd += dotPacked4x8EXT(g13, int(sx[xe + 13]));
                sa += dotPacked4x8EXT(g14, int(sx[xa + 14]));
                sb += dotPacked4x8EXT(g14, int(sx[xc + 14]));
                sc += dotPacked4x8EXT(g14, int(sx[xd + 14]));
                sd += dotPacked4x8EXT(g14, int(sx[xe + 14]));
                sa += dotPacked4x8EXT(g15, int(sx[xa + 15]));
                sb += dotPacked4x8EXT(g15, int(sx[xc + 15]));
                sc += dotPacked4x8EXT(g15, int(sx[xd + 15]));
                sd += dotPacked4x8EXT(g15, int(sx[xe + 15]));
                sa += dotPacked4x8EXT(g16, int(sx[xa + 16]));
                sb += dotPacked4x8EXT(g16, int(sx[xc + 16]));
                sc += dotPacked4x8EXT(g16, int(sx[xd + 16]));
                sd += dotPacked4x8EXT(g16, int(sx[xe + 16]));
