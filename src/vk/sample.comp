#version 450
/* Token sampling: temperature, top-k, top-p, one invocation.
 *
 * The best-k list lives in the second storage buffer, not in private arrays.
 * Adreno's compiler spills dynamically indexed private arrays to scratch and
 * then refuses the module (vkCreateComputePipelines returns VK_ERROR_UNKNOWN),
 * so the list is kept in global memory instead: a single invocation owns it,
 * so no barrier is needed and the traffic is only the k insertions, O(k log n)
 * instead of a second pass over the vocabulary.  Expensive per-element work
 * (exp) still happens only for the k survivors.
 *
 * Buffer layout, in uints:
 *   chosen[0]                     token
 *   chosen[2 .. 2+k)              descending logits as float bits
 *   chosen[2+KMAX .. 2+2*KMAX)    the matching vocabulary indices
 * The caller therefore reserves 2 + 2*KMAX uints (BQ_VK_SAMPLE_KMAX in
 * vk_backend.c must equal KMAX here).
 */
layout(local_size_x = 1) in;

#define KMAX 64
#define KV 2u
#define KI (2u + uint(KMAX))

layout(std430, binding = 0) readonly buffer LBuf { float logits[]; };
layout(std430, binding = 1) buffer SBuf { uint chosen[]; };

layout(push_constant) uniform PC {
    uint n; uint k; uint seed; uint flags;   /* flags bit0: greedy */
    float temperature; float top_p;
} pc;

uint pcg(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

void main() {
    uint n = pc.n;
    uint i;
    if ((pc.flags & 1u) != 0u || pc.temperature <= 0.0) {
        uint best = 0u;
        float bv = logits[0];
        for (i = 1u; i < n; ++i) if (logits[i] > bv) { bv = logits[i]; best = i; }
        chosen[0] = best;
        return;
    }

    uint k = pc.k;
    if (k == 0u || k > uint(KMAX)) k = uint(KMAX);
    if (k > n) k = n;

    uint have = 0u;
    /* keep the best k, descending; the common case is one compare */
    float lowest = -3.40282347e+38;
    for (i = 0u; i < n; ++i) {
        float v = logits[i];
        if (have == k && v <= lowest) continue;
        uint pos = have < k ? have++ : k - 1u;
        while (pos > 0u && uintBitsToFloat(chosen[KV + pos - 1u]) < v) {
            chosen[KV + pos] = chosen[KV + pos - 1u];
            chosen[KI + pos] = chosen[KI + pos - 1u];
            --pos;
        }
        chosen[KV + pos] = floatBitsToUint(v);
        chosen[KI + pos] = i;
        if (have == k) lowest = uintBitsToFloat(chosen[KV + k - 1u]);
    }
    if (have == 0u) { chosen[0] = 0u; return; }

    float mx = uintBitsToFloat(chosen[KV]);
    float tot = 0.0;
    for (i = 0u; i < have; ++i) {
        float e = exp((uintBitsToFloat(chosen[KV + i]) - mx) / pc.temperature);
        chosen[KV + i] = floatBitsToUint(e);
        tot += e;
    }

    /* top-p: keep the shortest prefix whose mass reaches the threshold */
    uint keep = have;
    if (pc.top_p > 0.0 && pc.top_p < 1.0) {
        float target = pc.top_p * tot;
        float acc = 0.0;
        for (i = 0u; i < have; ++i) {
            acc += uintBitsToFloat(chosen[KV + i]);
            if (acc >= target) { keep = i + 1u; break; }
        }
    }
    float mass = 0.0;
    for (i = 0u; i < keep; ++i) mass += uintBitsToFloat(chosen[KV + i]);

    float r = float(pcg(pc.seed)) * (1.0 / 4294967296.0) * mass;
    float acc2 = 0.0;
    uint pick = chosen[KI + keep - 1u];
    for (i = 0u; i < keep; ++i) {
        acc2 += uintBitsToFloat(chosen[KV + i]);
        pick = chosen[KI + i];
        if (acc2 >= r) break;
    }
    chosen[0] = pick;
}
